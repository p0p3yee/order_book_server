# Standalone build: copy this file to the node host; no local checkout needed.
# docker build -f Dockerfile.ws-low-latency --build-arg SOURCE_REVISION=<full-commit> -t hyperliquid-ws:<tag> .
FROM rust:1.94.0-bookworm AS build
ARG SOURCE_REVISION
RUN test -n "$SOURCE_REVISION" && git clone https://github.com/p0p3yee/order_book_server.git /app
WORKDIR /app
RUN git checkout --detach "$SOURCE_REVISION"
RUN SOURCE_REVISION="$SOURCE_REVISION" cargo build --locked --release --bin websocket_server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/websocket_server /usr/local/bin/websocket_server
ENV RUST_LOG=info
ENV RAYON_NUM_THREADS=2
ENV TOKIO_WORKER_THREADS=2
ENV WS_WALLET_POLL_INTERVAL_MS=1000
EXPOSE 8000
ENTRYPOINT ["websocket_server"]
