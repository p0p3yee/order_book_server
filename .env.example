# Directory directly containing node_order_statuses_by_block etc.
# If hype is the node's home/hl volume, append its actual data subdirectory here.
HL_DATA_DIR=/path/to/node-data
# SAME underlying file, as addressed inside the hl-node container (verify its mounts).
HL_NODE_SNAPSHOT_PATH=/path/in/node/data/ws-snapshot.json
WS_UID=1000
WS_GID=1000
WS_MARKETS=BTC,HYPE,AERO,xyz:NVDA,xyz:DRAM
WS_INTEGRITY_INTERVAL_SECS=0
WS_POLL_INTERVAL_MS=5
RAYON_NUM_THREADS=2
TOKIO_WORKER_THREADS=2
RUST_LOG=info
